{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrivateVox",
  "version": "0.2.0",
  "identifier": "com.drake0306.privatevox",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pill",
        "title": "PrivateVox",
        "url": "pill.html",
        "width": 280,
        "height": 48,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false
      },
      {
        "label": "panel",
        "title": "PrivateVox",
        "url": "panel.html",
        "width": 1100,
        "height": 780,
        "visible": false,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "resources": {
      "../resources/models/ggml-silero-v5.1.2.bin": "resources/models/ggml-silero-v5.1.2.bin"
    },
    "shortDescription": "Local voice dictation with Whisper",
    "longDescription": "Hold a key, talk, release: the text lands in the app in front. Whisper runs on your own GPU; nothing leaves the machine.",
    "category": "Productivity",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
