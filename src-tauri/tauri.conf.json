{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrivateVox",
  "version": "0.1.0",
  "identifier": "com.drake0306.privatevox",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pill",
        "title": "PrivateVox",
        "url": "pill.html",
        "width": 280,
        "height": 48,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false
      },
      {
        "label": "panel",
        "title": "PrivateVox",
        "url": "panel.html",
        "width": 560,
        "height": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "resources": {
      "../resources/models/ggml-silero-v5.1.2.bin": "resources/models/ggml-silero-v5.1.2.bin"
    }
  }
}
